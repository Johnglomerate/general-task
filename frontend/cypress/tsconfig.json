{
    "compilerOptions": {
        "target": "es2018",
        "lib": ["es2018", "dom"],
        "types": ["node", "cypress", "@testing-library/cypress"],
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "noEmit": true,
        "isolatedModules": false
    },
    "include": ["**/*.ts", "../cypress.config.ts", "../src/utils/types.ts", "../src/constants.ts"]
}
